  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "label"
              }
            },
            {
              "for": {
                "in": "value"
              }
            },
            {
              "for": {
                "in": "sortOrder"
              }
            },
            {
              "for": {
                "in": "displayMode"
              }
            },
            {
              "for": {
                "in": "selectionMode"
              }
            },
            {
              "for": {
                "in": "shortLabel"
              }
            },
            {
              "for": {
                "in": "defaultValue"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        }
      }
    }
